# ResumeBot .gitignore

# Database
data/*.db
data/*.sqlite3

# Environment
.env
.env.local
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Uploads (user data)
data/uploads/*
!data/uploads/.gitkeep

# Testing artifacts
cookies.txt

# Playwright browsers
data/boss_cookies.json

# Logs
*.log
